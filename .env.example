# AuraDine AI - Environment Variables Template
PROJECT_NAME="AuraDine AI"
ENVIRONMENT="production"
DEBUG=False

# Security
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Database
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres"

# Google Gemini 3.x Flash AI API
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN="your-meta-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_VERIFY_TOKEN="auradine_webhook_verify_secret_123"

# Razorpay
RAZORPAY_KEY_ID="rzp_live_key"
RAZORPAY_KEY_SECRET="rzp_live_secret"

# Stripe
STRIPE_SECRET_KEY="sk_live_key"
STRIPE_WEBHOOK_SECRET="whsec_secret"
